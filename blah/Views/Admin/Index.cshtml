@model blah.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Painel Admin";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="car-details-page">
        <section class="car-details-card">
            <a class="back-link" asp-controller="Home" asp-action="Index">← Voltar à loja</a>
            <h1 class="car-details-title">Painel Admin</h1>
            <p class="car-price">Total em carrinhos: @Model.CartTotal.ToString("C0")</p>

            <h2 class="car-details-subtitle">Utilizadores</h2>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Admin</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@(user.IsAdmin ? "Sim" : "Não")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h2 class="car-details-subtitle">Itens em carrinhos</h2>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Carro</th>
                        <th>Preço</th>
                        <th>Qtd</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CartItems)
                    {
                        <tr>
                            <td>@item.UserAccountId</td>
                            <td>@item.CarName</td>
                            <td>@item.UnitPrice.ToString("C0")</td>
                            <td>@item.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>

            <form asp-controller="Account" asp-action="Logout" method="post" class="add-cart-form">
                <button class="login-btn" type="submit">Terminar sessão</button>
            </form>
        </section>
    </main>
</body>
</html>
