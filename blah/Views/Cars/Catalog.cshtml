@model IEnumerable<blah.Models.CarDetailViewModel>
@{
    ViewData["Title"] = "Carros Disponíveis";
    Layout = null;
    var userName = Context.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #0b1120;">
    <div class="store-page" style="min-height: 100vh;">
        <header class="topbar">
            <div class="brand">STORE</div>
            <nav class="main-links">
                <a asp-controller="Home" asp-action="Index">Início</a>
                <a asp-controller="Cars" asp-action="Catalog">Carros</a>
                <a asp-controller="Cars" asp-action="Index">Personalizar o Seu carro</a>
                <a asp-controller="Home" asp-action="Contact">Contacto/Suporte</a>
            </nav>
            <a class="login-btn" asp-controller="Cart" asp-action="Index">Carrinho</a>
            @if (string.IsNullOrWhiteSpace(userName))
            {
                <a class="login-btn" asp-controller="Account" asp-action="Login">Iniciar sessão</a>
            }
            else
            {
                <div style="display:flex; gap:8px; align-items:center;">
                    <span class="login-btn" style="cursor:default;">@userName</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                        <button class="login-btn" type="submit" style="border:none;">Sair</button>
                    </form>
                </div>
            }
        </header>

        <main style="padding: 2rem; max-width: 1400px; margin: 0 auto;">
            <h1 class="testimonials-title" style="margin-bottom: 2rem; font-size: 2.5rem; text-align: center;">Os Nossos Carros</h1>

            <div class="sports-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;">
                @foreach (var car in Model)
                {
                    <article class="sport-item" style="cursor: pointer; transition: transform 0.2s; border: 1px solid #1f2937; border-radius: 8px; overflow: hidden; background: #111827; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);" 
                             onclick="location.href='@Url.Action("Details", "Cars", new { id = car.Id })'"
                             onmouseover="this.style.transform='translateY(-5px)'"
                             onmouseout="this.style.transform='translateY(0)'">
                        <img src="@car.ImagePath" alt="@car.Name" style="width: 100%; height: 200px; object-fit: cover;" />
                        <div style="padding: 1.5rem;">
                            <h3 style="color: white; margin: 0; font-size: 1.5rem;">@car.Name</h3>
                            <p style="color: #60a5fa; margin: 0.5rem 0 1rem 0; font-weight: bold; font-size: 1.1rem;">@car.Price.ToString("C0")</p>
                            <span style="display: inline-block; width: 100%; text-align: center; color: #fff; background-color: #3b82f6; padding: 0.75rem 1rem; border-radius: 4px; font-size: 1rem; font-weight: bold;">
                                Ver Detalhes &rarr;
                            </span>
                        </div>
                    </article>
                }
            </div>
        </main>
    </div>
</body>
</html>