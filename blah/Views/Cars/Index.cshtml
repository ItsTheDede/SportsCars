@model IEnumerable<blah.Models.CarDetailViewModel>
@{
    var firstCar = Model.FirstOrDefault(c => !string.IsNullOrEmpty(c.Model3dPath)) ?? Model.FirstOrDefault();
    ViewData["Title"] = "Personalizar o Seu carro";
    Layout = null;
    var userName = Context.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
    <style>
        .configurator-layout {
            display: flex;
            height: calc(100vh - 80px); /* Subtract header height */
            gap: 20px;
            padding: 20px;
            box-sizing: border-box;
        }
        .config-sidebar {
            width: 300px;
            background: #111827;
            border-radius: 8px;
            border: 1px solid #1f2937;
            padding: 20px;
            overflow-y: auto;
            color: white;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .config-main {
            flex-grow: 1;
            background: #cbd5e1; /* Lighter background to see shadows */
            border-radius: 8px;
            overflow: hidden;
            position: relative;
        }
        .car-option {
            padding: 10px;
            border-radius: 6px;
            background: #1f2937;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.2s;
        }
        .car-option:hover { background: #374151; }
        .car-option.active { border-color: #3b82f6; }

        .color-picker-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .color-picker-group label {
            font-size: 0.9rem;
            font-weight: bold;
            color: #9ca3af;
        }
        .color-picker-group input[type="color"] {
            width: 100%;
            height: 40px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
    </style>
</head>
<body style="background-color: #0b1120; margin: 0; padding: 0; height: 100vh; display: flex; flex-direction: column;">
    <header class="topbar">
        <div class="brand">STORE</div>
        <nav class="main-links">
            <a asp-controller="Home" asp-action="Index">Início</a>
            <a asp-controller="Cars" asp-action="Catalog">Carros</a>
            <a asp-controller="Cars" asp-action="Index">Personalizar o Seu carro</a>
            <a asp-controller="Home" asp-action="Contact">Contacto/Suporte</a>
        </nav>
        <a class="login-btn" asp-controller="Cart" asp-action="Index">Carrinho</a>
        @if (string.IsNullOrWhiteSpace(userName))
        {
            <a class="login-btn" asp-controller="Account" asp-action="Login">Iniciar sessão</a>
        }
        else
        {
            <div style="display:flex; gap:8px; align-items:center;">
                <span class="login-btn" style="cursor:default;">@userName</span>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                    <button class="login-btn" type="submit" style="border:none;">Sair</button>
                </form>
            </div>
        }
    </header>

    <div class="configurator-layout">
        <!-- Sidebar Esquerda: Escolha de Carros -->
        <aside class="config-sidebar">
            <h2 style="margin-top: 0; font-size: 1.2rem; border-bottom: 1px solid #374151; padding-bottom: 10px;">Modelos</h2>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                @foreach (var car in Model)
                {
                    <div class="car-option @(car.Id == firstCar?.Id ? "active" : "")"
                         data-id="@car.Id"
                         data-path="@car.Model3dPath"
                         data-name="@car.Name"
                         data-price="@car.Price"
                         onclick="changeCar(this)">
                        <h3 style="margin: 0; font-size: 1rem;">@car.Name</h3>
                        <p style="margin: 5px 0 0 0; color: #60a5fa; font-size: 0.85rem;">@car.Price.ToString("C0")</p>
                    </div>
                }
            </div>
        </aside>

        <!-- Main Area: Model Viewer -->
        <main class="config-main">
            @if (firstCar != null && !string.IsNullOrEmpty(firstCar.Model3dPath))
            {
                <model-viewer id="main-car-viewer"
                              src="@firstCar.Model3dPath"
                              alt="Modelo 3D"
                              auto-rotate
                              camera-controls
                              min-camera-orbit="auto 40deg auto"
                              max-camera-orbit="auto 95deg auto"
                              shadow-intensity="1"
                              exposure="1"
                              environment-image="neutral"
                              style="width: 100%; height: 100%;">
                </model-viewer>
                <div style="position: absolute; top: 20px; left: 20px; background: rgba(0,0,0,0.6); padding: 10px 20px; border-radius: 8px; color: white;">
                    <h2 id="current-car-name" style="margin: 0; font-size: 1.5rem;">@firstCar.Name</h2>
                    <p id="current-car-price" style="margin: 8px 0 0; color: #93c5fd; font-weight: 700;">@firstCar.Price.ToString("C0")</p>
                </div>
            }
            else
            {
                <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #374151;">
                    <h2>Nenhum modelo 3D disponível no momento.</h2>
                </div>
            }
        </main>

        <!-- Sidebar Direita: Customização -->
        <aside class="config-sidebar" style="width: 250px;">
            <h2 style="margin-top: 0; font-size: 1.2rem; border-bottom: 1px solid #374151; padding-bottom: 10px;">Personalização</h2>

            <div class="color-picker-group">
                <label for="body-color">Cor da Carroçaria</label>
                <input type="color" id="body-color" value="#ffffff" />
            </div>

            <div class="color-picker-group">
                <label for="rim-color">Cor das Rodas</label>
                <input type="color" id="rim-color" value="#cccccc" />
            </div>

            <div class="color-picker-group">
                <label for="interior-color">Cor do Interior</label>
                <input type="color" id="interior-color" value="#111111" />
            </div>

            <div class="color-picker-group">
                <label for="engine-upgrade">Motor</label>
                <select id="engine-upgrade" class="login-field" style="margin: 0;">
                    <option value="0">Stock</option>
                    <option value="3500">Stage 1 (+3 500 €)</option>
                    <option value="8000">Stage 2 (+8 000 €)</option>
                    <option value="15000">Stage 3 / Track (+15 000 €)</option>
                </select>
            </div>

            <div class="color-picker-group">
                <label for="turbo-upgrade">Turbo</label>
                <select id="turbo-upgrade" class="login-field" style="margin: 0;">
                    <option value="0">Original</option>
                    <option value="2200">Turbo Sport (+2 200 €)</option>
                    <option value="5200">Turbo Performance (+5 200 €)</option>
                </select>
            </div>

            <div class="color-picker-group">
                <label for="brake-upgrade">Travagem</label>
                <select id="brake-upgrade" class="login-field" style="margin: 0;">
                    <option value="0">Original</option>
                    <option value="1800">Kit Desportivo (+1 800 €)</option>
                    <option value="4600">Big Brake Kit (+4 600 €)</option>
                </select>
            </div>

            <div class="color-picker-group">
                <label for="suspension-upgrade">Suspensão</label>
                <select id="suspension-upgrade" class="login-field" style="margin: 0;">
                    <option value="0">Original</option>
                    <option value="1400">Street Performance (+1 400 €)</option>
                    <option value="3900">Coilovers Ajustáveis (+3 900 €)</option>
                </select>
            </div>

            <div style="border-top: 1px solid #374151; padding-top: 12px;">
                <p style="margin: 0; color: #9ca3af; font-size: 0.85rem;">Preço Total</p>
                <p id="config-total" style="margin: 6px 0 0; color: #60a5fa; font-weight: 800; font-size: 1.3rem;">@firstCar.Price.ToString("C0")</p>
            </div>

            <form asp-controller="Cart" asp-action="Add" method="post" id="config-add-cart-form" style="margin-top: auto;">
                <input type="hidden" name="id" id="selected-car-id" value="@(firstCar?.Id ?? string.Empty)" />
                <button type="submit" style="width: 100%; padding: 15px; background: #3b82f6; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 1rem;">
                    Finalizar Configuração
                </button>
            </form>
        </aside>
    </div>

    <script>
        const modelViewer = document.querySelector('#main-car-viewer');
        const bodyColor = document.querySelector('#body-color');
        const rimColor = document.querySelector('#rim-color');
        const interiorColor = document.querySelector('#interior-color');
        const engineUpgrade = document.querySelector('#engine-upgrade');
        const turboUpgrade = document.querySelector('#turbo-upgrade');
        const brakeUpgrade = document.querySelector('#brake-upgrade');
        const suspensionUpgrade = document.querySelector('#suspension-upgrade');
        const totalLabel = document.querySelector('#config-total');
        const carPriceLabel = document.querySelector('#current-car-price');
        const selectedCarIdInput = document.querySelector('#selected-car-id');
        const materialAssignments = {
            body: [],
            rim: [],
            kit: [],
            interior: []
        };
        const customColors = {
            body: null,
            rim: null,
            interior: null
        };
        let currentModelPath = '@(firstCar?.Model3dPath ?? string.Empty)';
        let selectedCarId = '@(firstCar?.Id ?? string.Empty)';

        let basePrice = @((firstCar?.Price ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const eur = new Intl.NumberFormat('pt-PT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

        function changeCar(element) {
            const carId = element.dataset.id;
            const path = element.dataset.path;
            const name = element.dataset.name;
            const price = Number(element.dataset.price || 0);

            if (carId) {
                selectedCarId = carId;
                if (selectedCarIdInput) {
                    selectedCarIdInput.value = selectedCarId;
                }
            }

            if (!path || !modelViewer) return;

            document.querySelectorAll('.car-option').forEach(el => el.classList.remove('active'));
            element.classList.add('active');

            const cacheBustedPath = `${path}${path.includes('?') ? '&' : '?'}v=${Date.now()}`;
            modelViewer.src = cacheBustedPath;
            currentModelPath = path;
            document.getElementById('current-car-name').innerText = name;
            basePrice = price;

            customColors.body = null;
            customColors.rim = null;
            customColors.interior = null;
            materialAssignments.body = [];
            materialAssignments.rim = [];
            materialAssignments.kit = [];
            materialAssignments.interior = [];

            if (carPriceLabel) {
                carPriceLabel.textContent = eur.format(basePrice);
            }
            updateTotal();
        }

        function hexToFactor(hex) {
            const safeHex = (hex || '').replace('#', '');
            if (safeHex.length !== 6) return [1, 1, 1, 1];
            const r = parseInt(safeHex.slice(0, 2), 16) / 255;
            const g = parseInt(safeHex.slice(2, 4), 16) / 255;
            const b = parseInt(safeHex.slice(4, 6), 16) / 255;
            return [r, g, b, 1];
        }

        function getMaterialsByKeywords(keywords) {
            if (!modelViewer?.model?.materials?.length) return [];
            const materials = modelViewer.model.materials;
            const normalizedKeywords = keywords.map(k => k.toLowerCase());
            const matches = [];

            for (const material of materials) {
                const materialName = (material.name || '').toLowerCase();
                if (normalizedKeywords.some(k => materialName.includes(k))) {
                    matches.push(material);
                }
            }

            return matches;
        }

        function getMaterialName(material) {
            return (material?.name || '').toLowerCase();
        }

        function getMaterialsByKeywordsWithExclusions(keywords, excludedKeywords = []) {
            const matches = getMaterialsByKeywords(keywords);
            if (!matches.length || !excludedKeywords.length) return matches;
            const normalizedExcluded = excludedKeywords.map(k => k.toLowerCase());
            return matches.filter(material => {
                const materialName = getMaterialName(material);
                return !normalizedExcluded.some(x => materialName.includes(x));
            });
        }

        function assignMaterials() {
            if (!modelViewer?.model?.materials?.length) return;

            if (currentModelPath && currentModelPath.includes('bmw_m4_competition.glb')) {
                materialAssignments.rim = getMaterialsByKeywords(['rim', 'disc', 'caliper', 'brake']);
                materialAssignments.interior = getMaterialsByKeywords(['interior']);
                materialAssignments.kit = getMaterialsByKeywords(['bodykit', 'spoiler']);
                materialAssignments.body = getMaterialsByKeywordsWithExclusions(
                    ['body', 'hood', 'bodykit', 'spoiler'],
                    ['glass', 'rim', 'wheel', 'tire', 'interior', 'seat', 'cabin', 'dashboard', 'caliper', 'brake', 'disc', 'logo', 'emblem', 'light', 'lamp', 'bodykit', 'spoiler']
                );

                if (materialAssignments.body.length === 0) {
                    materialAssignments.body = getMaterialsByKeywords(['body', 'bodykit']);
                }

                if (materialAssignments.kit.length === 0) {
                    materialAssignments.kit = getMaterialsByKeywords(['bodykit']);
                }

                return;
            }

            const allMaterials = modelViewer.model.materials;
            const reserved = new Set();
            const reserve = (materials) => {
                const unique = [];
                for (const material of materials) {
                    if (reserved.has(material)) continue;
                    reserved.add(material);
                    unique.push(material);
                }
                return unique;
            };

            materialAssignments.rim = reserve(getMaterialsByKeywordsWithExclusions(
                ['rim', 'wheel', 'jante', 'alloy', 'caliper', 'brake'],
                ['arch', 'fender', 'body', 'kit', 'skirt', 'door', 'panel', 'bumper']
            ));

            materialAssignments.interior = reserve(getMaterialsByKeywordsWithExclusions(
                ['interior', 'seat', 'cabin', 'cockpit', 'dashboard', 'trim', 'upholstery'],
                ['body', 'kit', 'bumper', 'spoiler', 'wing', 'glass', 'window', 'rim', 'wheel']
            ));

            materialAssignments.kit = reserve(getMaterialsByKeywordsWithExclusions(
                ['bodykit', 'splitter', 'diffuser', 'spoiler', 'wing', 'lip', 'skirt', 'canard', 'aero', 'bumper'],
                ['glass', 'window', 'rim', 'wheel', 'tire', 'tyre', 'interior', 'seat', 'cabin', 'dashboard', 'logo', 'emblem']
            ));

            materialAssignments.body = reserve(getMaterialsByKeywordsWithExclusions(
                ['paint', 'body', 'carrosser', 'car_body', 'exterior'],
                ['glass', 'window', 'rim', 'wheel', 'tire', 'tyre', 'interior', 'seat', 'cabin', 'dashboard', 'logo', 'emblem', 'caliper', 'brake', 'disc', 'light', 'lamp', 'bodykit', 'splitter', 'diffuser', 'spoiler', 'wing', 'lip', 'skirt', 'canard', 'aero']
            ));

            if (materialAssignments.body.length === 0) {
                const fallback = allMaterials.filter(material => {
                    if (reserved.has(material)) return false;
                    const name = getMaterialName(material);
                    return !['glass', 'window', 'rim', 'wheel', 'tire', 'tyre', 'interior', 'seat', 'cabin', 'dashboard', 'logo', 'emblem', 'light', 'lamp'].some(x => name.includes(x));
                });

                materialAssignments.body = reserve(fallback.slice(0, 1));
            }
        }

        function setMaterialColor(material, factor, type) {
            if (!material?.pbrMetallicRoughness) return;

            material.pbrMetallicRoughness.setBaseColorFactor([factor[0], factor[1], factor[2], 1]);
        }

        function applyColor(type, hexColor) {
            if(!modelViewer || !modelViewer.model) return;

            const factor = hexToFactor(hexColor);
            const targetMaterials = materialAssignments[type] || [];

            if (targetMaterials.length === 0) return;

            for (const material of targetMaterials) {
                setMaterialColor(material, factor, type);
            }
        }

        function bindColorPicker(input, type) {
            if (!input) return;
            input.addEventListener('input', (e) => {
                customColors[type] = e.target.value;

                if ((materialAssignments[type] || []).length === 0) {
                    assignMaterials();
                }

                applyColor(type, e.target.value);
            });
        }

        bindColorPicker(bodyColor, 'body');
        bindColorPicker(interiorColor, 'interior');

        if (rimColor) {
            rimColor.addEventListener('input', (e) => {
                customColors.rim = e.target.value;

                if ((materialAssignments.rim || []).length === 0 || (materialAssignments.kit || []).length === 0) {
                    assignMaterials();
                }

                applyColor('rim', e.target.value);
                applyColor('kit', e.target.value);
            });
        }

        function updateTotal() {
            const extras =
                Number(engineUpgrade?.value || 0) +
                Number(turboUpgrade?.value || 0) +
                Number(brakeUpgrade?.value || 0) +
                Number(suspensionUpgrade?.value || 0);

            if (totalLabel) {
                totalLabel.textContent = eur.format(basePrice + extras);
            }
        }

        [engineUpgrade, turboUpgrade, brakeUpgrade, suspensionUpgrade].forEach(el => {
            if (el) {
                el.addEventListener('change', updateTotal);
            }
        });

        // Apply colors as soon as model loads
        if (modelViewer) {
            modelViewer.addEventListener('load', () => {
                assignMaterials();

                if (customColors.body) applyColor('body', customColors.body);
                if (customColors.rim) applyColor('rim', customColors.rim);
                if (customColors.rim) applyColor('kit', customColors.rim);
                if (customColors.interior) applyColor('interior', customColors.interior);
            });

            modelViewer.addEventListener('error', () => {
                alert('Não foi possível carregar este modelo 3D. Verifica o ficheiro .glb e faz Ctrl+F5.');
            });
        }

        updateTotal();
    </script>
</body>
</html>