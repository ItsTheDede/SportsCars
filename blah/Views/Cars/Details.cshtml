@model blah.Models.CarDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="car-details-page">
        <section class="car-details-card">
            <a class="back-link" asp-controller="Home" asp-action="Index">← Voltar</a>
            <h1 class="car-details-title">@Model.Name</h1>
            <p class="car-price">Preço: @Model.Price.ToString("C0")</p>

            <div class="3d-viewer-container" style="margin-bottom: 2rem;">
                @if (!string.IsNullOrEmpty(Model.Model3dPath))
                {
                    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>
                    <div style="width: 100%; height: 400px; border-radius: 8px; overflow: hidden; background: #eee;">
                        <model-viewer id="car-viewer"
                                      src="@Model.Model3dPath"
                                      alt="Modelo 3D de @Model.Name"
                                      auto-rotate
                                      camera-controls
                                      shadow-intensity="1"
                                      style="width: 100%; height: 100%;">
                        </model-viewer>
                    </div>
                    <div style="margin-top: 15px; text-align: center;">
                        <label for="car-color" style="font-weight: bold; margin-right: 10px;">Personalizar Cor:</label>
                        <input type="color" id="car-color" value="#ffffff" style="cursor: pointer;" />
                        <script>
                            document.addEventListener("DOMContentLoaded", () => {
                                const modelViewer = document.querySelector('#car-viewer');
                                const colorPicker = document.querySelector('#car-color');

                                colorPicker.addEventListener('input', (event) => {
                                    if(!modelViewer.model) return;
                                    const material = modelViewer.model.materials[0]; // Assume que o primeiro material principal é o corpo
                                    if (material) {
                                        material.pbrMetallicRoughness.setBaseColorFactor(event.target.value);
                                    }
                                });
                            });
                        </script>
                    </div>
                }
                else
                {
                    <img class="car-details-image" src="@Model.ImagePath" alt="@Model.Name" />
                }
            </div>

            <form asp-controller="Cart" asp-action="Add" method="post" class="add-cart-form">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="buy-btn" type="submit">Adicionar ao carrinho</button>
            </form>

            <a class="login-btn" asp-controller="Cart" asp-action="Index">Carrinho</a>

            <p class="auth-switch">
                <a asp-controller="Cart" asp-action="Index">Ver carrinho</a>
                @if (Context.Session.GetInt32("IsAdmin") == 1)
                {
                    <span> | </span><a asp-controller="Admin" asp-action="Index">Painel Admin</a>
                }
            </p>

            <h2 class="car-details-subtitle">Possíveis modificações</h2>
            <ul class="car-mod-list">
                @foreach (var mod in Model.PossibleModifications)
                {
                    <li>@mod</li>
                }
            </ul>
        </section>
    </main>
</body>
</html>
